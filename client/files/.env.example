# Copy this file to .env and fill in real values from your EmailJS dashboard.
# Never commit the real .env file — add it to .gitignore if it isn't already.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# New — separate template for membership approve/reject confirmation emails.
# Same service and public key as above, just a second template.
VITE_EMAILJS_MEMBERSHIP_TEMPLATE_ID=
